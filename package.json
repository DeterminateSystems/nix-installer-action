{
  "name": "nix-installer-action",
  "version": "1.0.0",
  "description": "You can use [`nix-installer`](https://github.com/DeterminateSystems/nix-installer) as a Github Action:",
  "keywords": [],
  "homepage": "https://github.com/DeterminateSystems/nix-installer-action#readme",
  "bugs": {
    "url": "https://github.com/DeterminateSystems/nix-installer-action/issues"
  },
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeterminateSystems/nix-installer-action.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "format": "oxfmt",
    "check-fmt": "oxfmt --check .",
    "lint": "oxlint src",
    "package": "ncc build",
    "test": "vitest --run",
    "all": "npm run test && npm run format && npm run lint && npm run build && npm run package"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@determinate-systems/detsys-ts": "^2.0.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "got": "^14.6.6",
    "string-argv": "^0.3.2",
    "vitest": "^5.0.5"
  },
  "devDependencies": {
    "@determinate-systems/oxlint-config": "^1.0.0",
    "@types/node": "^24.19.2",
    "@types/uuid": "^9.0.8",
    "@vercel/ncc": "^0.38.4",
    "oxlint-tsgolint": "^7.0.2004",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
